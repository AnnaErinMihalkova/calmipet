# Local SQLite (default)
# DATABASE_URL=sqlite:///./data/calmipet.db

# Supabase PostgreSQL (production)
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use "Transaction" pooler (port 6543) for Render/serverless.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

JWT_SECRET=change-me-before-production
JWT_EXPIRY_HOURS=24
CALMIPET_SKIP_RATE_LIMIT=1
