# Backend Configuration (FastAPI)
# Note: Render automatically provides the PORT variable.
# If using SQLite on Render, ensure a persistent disk is mounted at /app/data
DATABASE_URL=sqlite:///./data/calmipet.db
CALMIPET_SKIP_RATE_LIMIT=1

# Frontend Configuration (React)
# Replace with your actual Render backend URL (e.g., https://calmipet-backend.onrender.com/api/)
REACT_APP_API_BASE_URL=https://calmipet-backend.onrender.com/api/

# Mobile Configuration (Expo)
# Replace with your actual Render backend and frontend URLs
EXPO_PUBLIC_API_BASE_URL=https://calmipet-backend.onrender.com/api/
EXPO_PUBLIC_WEB_URL=https://calmipet-frontend.onrender.com/api/
