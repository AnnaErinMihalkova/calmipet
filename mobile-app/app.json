{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "CalmiPet uses Bluetooth to connect to your ESP32 bracelet for heart rate and SpO2 readings."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calmipet.mobile",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "CalmiPet uses Bluetooth to connect to your ESP32 bracelet for heart rate and SpO2 readings.",
        "NSBluetoothPeripheralUsageDescription": "CalmiPet uses Bluetooth to connect to your ESP32 bracelet for heart rate and SpO2 readings.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.calmipet.mobile",
      "usesCleartextTraffic": true,
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c2162b86-0925-4f53-972f-ef802ea2d909"
      }
    }
  }
}
